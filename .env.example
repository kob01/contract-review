# ============================================================
# 信贷合同合规审查系统 · 环境变量样例
# 复制为 .env 后按实际环境修改；.env 不会进版本库
# ============================================================

# ---------- 应用 ----------
APP_NAME=信贷合同合规审查系统
ENVIRONMENT=dev
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=change-me-in-production

# ---------- 数据库（PostgreSQL + pgvector）----------
DB_PORT=5433
DATABASE_URL=postgresql+asyncpg://contract_review:contract_review@localhost:5433/contract_review
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 无法访问 Docker Hub 时改用镜像站：docker.m.daocloud.io/pgvector/pgvector:pg16
PGVECTOR_IMAGE=pgvector/pgvector:pg16

# ---------- LLM（OpenAI 兼容接口）----------
# auto：有密钥走真实模型，无密钥退回离线 Mock（结论会标注仅用于流程验证）
LLM_PROVIDER=auto
# 智谱 GLM 的 OpenAI 兼容端点（国际站：https://api.z.ai/api/paas/v4）
# 其他可切换：DeepSeek / 通义 compatible-mode / Kimi / OpenAI / vLLM / Ollama(/v1)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 密钥不进仓库：写在仓库上级目录的 .env（例如 d:\ai\.env 或 ~/contract-review 之外的 .env）
# 内容形如：LLM_API_KEY=<你的密钥>；该文件已纳入后端 dotenv 查找链且优先级最高
LLM_MODEL=glm-5.3-flash
LLM_TEMPERATURE=0
# 思考型模型（如 GLM-5.3）推理 token 也计入预算，需比非思考模型留更多余量
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CHARS_PER_CALL=12000
LLM_MAX_CONCURRENCY=3

# ---------- 向量与检索（RAG）----------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# 留空则复用 LLM_BASE_URL / LLM_API_KEY
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# true：离线哈希向量，仅用于跑通链路，检索结果不具备语义相关性，禁止用于出报告
RAG_USE_MOCK_EMBEDDING=true
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.30
VECTOR_INDEX_TYPE=hnsw

# ---------- 监管阈值口径 ----------
# 一年期 LPR（小数）。司法保护上限 = LPR × 倍数，请按月更新并记录生效日
LPR_ONE_YEAR_RATE=0.0310
LPR_MULTIPLE=4.0
# 消费金融/小贷综合融资成本红线
REGULATORY_COST_CEILING=0.24
# 历史高利贷参考线，用于分级提示
HISTORICAL_HARD_CEILING=0.36
# 置信度路由：低于该值的模型结论强制转人工法务复核
CONFIDENCE_ROUTING_THRESHOLD=0.80
MANDATORY_HUMAN_REVIEW_FOR_HIGH_RISK=true

# ---------- 文件上传 ----------
# UPLOAD_DIR 默认为 backend/storage/contracts
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_SUFFIXES=.pdf,.docx,.txt,.md

# ---------- 监管公开信息采集（默认关闭）----------
# 开启前必须自行核对目标站点 robots.txt 与使用条款
INGESTION_ENABLED=false
INGESTION_USER_AGENT=contract-review-compliance-bot/0.1
INGESTION_MIN_INTERVAL_SECONDS=3
INGESTION_MAX_ITEMS_PER_RUN=50

# ---------- 前端（Vite 只暴露 VITE_ 前缀变量）----------
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_BASE_URL=/api/v1
